# Copiar a .env (fuera del control de versiones) y completar con las credenciales reales.

ORACLE_USER=AUDITOR_APP
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/XEPDB1

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Si no hay Oracle disponible, el backend puede servir los snapshots en lugar de consultar en vivo
DEMO_MODE=false
