# Copiar a .env (ignorado por Git) y completar. Nunca subir .env al repositorio.

# Llave Fernet para cifrar en reposo las contraseñas de los usuarios auditores.
# Generar una con:  python -c "from app.conexiones import generar_llave; print(generar_llave())"
# Si no se define, las empresas se registran sin contraseña guardada y esta se envía en cada operación.
AUDITORIA_LLAVE_CIFRADO=

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Opcionales (valores por defecto entre paréntesis)
# AUDITORIA_DB=            (backend/data/auditoria.db)
# AUDITORIA_INSTRUMENTO_DIR=   (instrumento/ en la raíz del repositorio)
# AUDITORIA_CALL_TIMEOUT_MS=30000
# AUDITORIA_CONNECT_TIMEOUT_S=10
# AUDITORIA_MAX_FILAS=2000
